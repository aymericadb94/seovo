{
  "crons": [
    {
      "path": "/api/cron/recalc",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "app/api/cron/recalc/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/publish/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/trigger/route.ts": {
      "maxDuration": 300
    },
    "app/api/generate/route.ts": {
      "maxDuration": 120
    }
  }
}
